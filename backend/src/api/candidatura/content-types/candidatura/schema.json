{
  "kind": "collectionType",
  "collectionName": "candidaturas",
  "info": {
    "singularName": "candidatura",
    "pluralName": "candidaturas",
    "displayName": "Candidatura",
    "description": "Liga um currículo a uma vaga. A data é o createdAt."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "situacao": {
      "type": "enumeration",
      "enum": ["enviada", "em_analise", "aprovada", "recusada"],
      "default": "enviada",
      "required": true
    },
    "vaga": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::vaga.vaga",
      "inversedBy": "candidaturas"
    },
    "curriculo": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::curriculo.curriculo",
      "inversedBy": "candidaturas"
    }
  }
}
