{
  "kind": "collectionType",
  "collectionName": "curriculos",
  "info": {
    "singularName": "curriculo",
    "pluralName": "curriculos",
    "displayName": "Currículo",
    "description": "Currículo do candidato. Cada candidato tem no máximo um."
  },
  "options": {
    "draftAndPublish": false
  },
  "attributes": {
    "nome": { "type": "string", "required": true, "minLength": 2, "maxLength": 120 },
    "cidade": { "type": "string", "required": true, "maxLength": 80 },
    "telefone": { "type": "string", "required": true, "maxLength": 20 },
    "cnh": {
      "type": "enumeration",
      "enum": ["nenhuma", "B", "C", "D", "E"],
      "default": "nenhuma",
      "required": true
    },
    "anosExperiencia": { "type": "integer", "min": 0, "max": 60, "default": 0, "required": true },
    "equipamentos": { "type": "string", "maxLength": 300 },
    "resumo": { "type": "text", "maxLength": 2000 },
    "candidato": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "candidaturas": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::candidatura.candidatura",
      "mappedBy": "curriculo"
    }
  }
}
